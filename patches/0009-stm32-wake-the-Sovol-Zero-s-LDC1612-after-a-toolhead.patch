From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Logan Saunders <32494494+RealMrLogan@users.noreply.github.com>
Date: Tue, 17 Nov 2026 11:18:27 -0700
Subject: [PATCH] stm32: wake the Sovol Zero's LDC1612 after a toolhead reset

On the Zero's F103 toolhead, the LDC1612 on i2c2 NACKs the first
transfer after the MCU resets and answers normally after that (seen with
a bus scan and a single dummy transfer). Upstream's first transfer is the
probe's ID read, so homing shut down with "START_NACK". Sovol's i2c code
hid this by resetting the bus and retrying on every error; here the bus
is recovered once at setup (nine SCL pulses and a STOP, then a peripheral
reset) and the device gets one throwaway address transfer. Errors after
that stay fatal, as upstream.
---
 src/stm32/i2c.c | 54 +++++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 48 insertions(+), 6 deletions(-)

diff --git a/src/stm32/i2c.c b/src/stm32/i2c.c
index 7ecbcd6da..59d34eed1 100644
--- a/src/stm32/i2c.c
+++ b/src/stm32/i2c.c
@@ -51,18 +51,59 @@ static const struct i2c_info i2c_bus[] = {
 #endif
 };
 
-// Work around stm32 errata causing busy bit to be stuck
 static void
-i2c_busy_errata(uint8_t scl_pin, uint8_t sda_pin)
+i2c_delay_us(uint32_t us)
+{
+    uint32_t end = timer_read_time() + timer_from_us(us);
+    while (timer_is_before(timer_read_time(), end))
+        ;
+}
+
+// Work around stm32 errata causing busy bit to be stuck: release a device
+// left mid-transfer (nine SCL pulses, then a STOP) and reset the peripheral
+static void
+i2c_busy_errata(I2C_TypeDef *i2c, uint8_t scl_pin, uint8_t sda_pin)
 {
     if (! CONFIG_MACH_STM32F1)
         return;
-    gpio_peripheral(scl_pin, GPIO_OUTPUT | GPIO_OPEN_DRAIN, 1);
     gpio_peripheral(sda_pin, GPIO_OUTPUT | GPIO_OPEN_DRAIN, 1);
-    gpio_peripheral(sda_pin, GPIO_OUTPUT | GPIO_OPEN_DRAIN, -1);
-    gpio_peripheral(scl_pin, GPIO_OUTPUT | GPIO_OPEN_DRAIN, -1);
     gpio_peripheral(scl_pin, GPIO_OUTPUT | GPIO_OPEN_DRAIN, 1);
+    int i;
+    for (i = 0; i < 9; i++) {
+        i2c_delay_us(5);
+        gpio_peripheral(scl_pin, GPIO_OUTPUT | GPIO_OPEN_DRAIN, -1);
+        i2c_delay_us(5);
+        gpio_peripheral(scl_pin, GPIO_OUTPUT | GPIO_OPEN_DRAIN, 1);
+    }
+    gpio_peripheral(sda_pin, GPIO_OUTPUT | GPIO_OPEN_DRAIN, -1);
+    i2c_delay_us(5);
     gpio_peripheral(sda_pin, GPIO_OUTPUT | GPIO_OPEN_DRAIN, 1);
+    i2c_delay_us(5);
+    i2c->CR1 = I2C_CR1_SWRST;
+    i2c_delay_us(5);
+    i2c->CR1 = 0;
+}
+
+// The Sovol Zero's LDC1612 NACKs the first transfer after the toolhead
+// resets and answers normally after it: send it a throwaway address-only
+// transfer, its result ignored
+static void
+i2c_wake_device(I2C_TypeDef *i2c, uint8_t addr)
+{
+    if (! CONFIG_MACH_STM32F1)
+        return;
+    uint32_t timeout = timer_read_time() + timer_from_us(2000);
+    i2c->CR1 = I2C_CR1_START | I2C_CR1_PE;
+    while (!(i2c->SR1 & I2C_SR1_SB)
+           && timer_is_before(timer_read_time(), timeout))
+        ;
+    i2c->DR = addr << 1;
+    while (!(i2c->SR1 & (I2C_SR1_ADDR | I2C_SR1_AF))
+           && timer_is_before(timer_read_time(), timeout))
+        ;
+    (void)i2c->SR2;
+    i2c->SR1 = 0; // clear AF
+    i2c->CR1 = I2C_CR1_STOP | I2C_CR1_PE;
 }
 
 struct i2c_config
@@ -77,7 +118,7 @@ i2c_setup(uint32_t bus, uint32_t rate, uint8_t addr)
     if (!is_enabled_pclock((uint32_t)i2c)) {
         // Enable i2c clock and gpio
         enable_pclock((uint32_t)i2c);
-        i2c_busy_errata(ii->scl_pin, ii->sda_pin);
+        i2c_busy_errata(i2c, ii->scl_pin, ii->sda_pin);
         gpio_peripheral(ii->scl_pin, GPIO_FUNCTION(4) | GPIO_OPEN_DRAIN, 1);
         gpio_peripheral(ii->sda_pin, GPIO_FUNCTION(4) | GPIO_OPEN_DRAIN, 1);
         i2c->CR1 = I2C_CR1_SWRST;
@@ -89,6 +130,7 @@ i2c_setup(uint32_t bus, uint32_t rate, uint8_t addr)
         i2c->CCR = pclk / 100000 / 2;
         i2c->TRISE = (pclk / 1000000) + 1;
         i2c->CR1 = I2C_CR1_PE;
+        i2c_wake_device(i2c, addr);
     }
 
     return (struct i2c_config){ .i2c=i2c, .addr=addr<<1 };

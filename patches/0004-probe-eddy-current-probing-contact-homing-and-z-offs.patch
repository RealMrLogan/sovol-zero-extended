+// Notify trsync of event
+static void
+notify_trigger(struct ldc1612 *ld, uint32_t time, uint8_t reason)
+{
+    ld->homing_flags = 0;
+    ld->homing_clock = time;
+    trsync_do_trigger(ld->ts, reason);

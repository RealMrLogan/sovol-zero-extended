+void uc1701_shutdown(int reason)
+{
+	char buf[20] = "error code: ";
+	char code[10] = {0};
+	io_Init();
+	Init_S6B33B();
+	delay_ms(10);
+	clear_screen(0x00);
+	itoa(reason, code, 10);
+	strcat(buf, code);
+	uc1701WriteString(2, 1, "Printer is shutdown", FONT_SMALL);
+	uc1701WriteString(2, 3, "Restart the printer", FONT_SMALL);
+	uc1701WriteString(2, 5, buf, FONT_SMALL);
+}

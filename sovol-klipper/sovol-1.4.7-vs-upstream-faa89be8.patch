+void Display_pic1(unchar graphic[])
+{
+	unint i,j,adressd=0;
+
+	for(i=0;i<8;i++)
+	{
+		CS0_L;
+		Write_S6B33B_COM(0xb0+i);
+	    Write_S6B33B_COM(0x10);
+		Write_S6B33B_COM(0x00);
+		for(j=0;j<128;j++)
+		{
+			Write_S6B33B_DISPLAY_DATA_serial_4SPI(graphic[adressd]);

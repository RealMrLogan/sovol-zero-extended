#Systemd service file for moonraker-obico
[Unit]
Description=Moonraker-Obico
After=network-online.target moonraker.service

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
User=sovol
WorkingDirectory=/home/sovol/moonraker-obico
ExecStart=/home/sovol/moonraker-obico/../moonraker-obico-env/bin/python3 -m moonraker_obico.app -c /home/sovol/printer_data/config/moonraker-obico.cfg
Restart=always
RestartSec=5
